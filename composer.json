{
    "name": "morphp/medas-console",
    "description": "Medas console",
    "authors": [
        {
            "name": "Patrick Morpey",
            "email": "patrick@morphp.nl"
        }
    ],
    "type": "library",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "morphp/medas-service-manager": "dev-dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "morphp/medas-config-manager": "dev-dev",
        "morphp/medas-cache": "dev-dev"
    },
    "extra": {
        "branch-alias": {
            "dev-dev": "0.x-dev"
        }
    },
    "autoload": {
        "psr-4": {
            "Medas\\Console\\": "src/",
            "Medas\\ConsoleTest\\": "tests/"
        }
    }
}
